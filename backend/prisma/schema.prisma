generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  passwordHash        String
  role                UserRole            @default(USER)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  emailVerified       Boolean             @default(false)
  isActive            Boolean             @default(true)
  lastLoginAt         DateTime?
  name                String
  referralCode        String?             @unique
  referredBy          String?
  apiKeys             ApiKey[]
  orders              Order[]
  payments            Payment[]
  purchasedSocialLogs SocialLog[]         @relation("PurchasedSocialLogs")
  wallet              Wallet?
  transactions        WalletTransaction[]
  virtualAccounts VirtualAccount[]

  @@index([email])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// *
///  * ============================================================
///  * WALLET TRANSACTIONS
///  * ============================================================
model WalletTransaction {
  id            String            @id @default(uuid())
  userId        String
  type          TransactionType
  amount        Decimal           @db.Decimal(18, 2)
  description   String
  reference     String            @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  balanceAfter  Decimal?          @db.Decimal(18, 2)
  balanceBefore Decimal?          @db.Decimal(18, 2)
  metadata      Json?
  status        TransactionStatus @default(PENDING)
  refundedAt      DateTime?    // <-- ADD THIS LINE. Null = not refunded.
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
}


model VirtualAccount {
  id            String   @id @default(uuid())
  userId        String
  bank          String // "9psb" | "kuda"
  accountNumber String   @unique
  accountName   String
  provider      String   @default("POCKETFI")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One account per bank per user — a user can hold both a 9psb AND a
  // kuda account, but not two of the same bank.
  @@unique([userId, bank])
  @@index([userId])
  @@index([accountNumber])
}

model SocialLog {
  id              String             @id @default(cuid())
  platform        SocialPlatform
  country         String?
  username        String
  age             Int
  followers       Int?
  price           Decimal            @db.Decimal(10, 2)
  emailAttached   Boolean            @default(false)
  phoneAttached   Boolean            @default(false)
  twoFactor       Boolean            @default(false)
  ogEmail         Boolean            @default(false)
  verified        Boolean            @default(false)
  description     String?
  image           String?
  status          SocialLogStatus    @default(AVAILABLE)
  buyerId         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  backupCodes     Json?
  cookies         Json?
  /// PRIVATE LOGIN DETAILS
  loginEmail      String?
  emailPassword String?
  loginPhone      String?
  notes           String?
  password        String?
  recoveryEmail   String?
  twoFactorSecret String?
  purchasedAt     DateTime?
  category        SocialLogCategory
  pageType        SocialLogPageType?
  loginUsername   String?
  instagramSubType InstagramSubType?
  vpnType         VpnType?
  tutorialType    TutorialType?
  websiteType     WebsiteType?
  buyer           User?              @relation("PurchasedSocialLogs", fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([status])
  @@index([platform])
  @@index([category])
  @@index([vpnType])
  @@index([instagramSubType])
  @@index([tutorialType])
  @@index([websiteType])
}

model Order {
  id              String       @id @default(uuid())
  userId          String
  providerOrderId String?
  country         String
  operator        String
  service         String
  phoneNumber     String?
  providerCostUsd Decimal      @db.Decimal(18, 4)
  sellingPriceNgn Decimal      @db.Decimal(18, 2)
  status          OrderStatus  @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  activationType  String
  provider        String       @default("FIVESIM")
  refundedAt      DateTime?    // <-- ADD THIS LINE. Null = not refunded.
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  smsMessages     SmsMessage[]

  @@index([userId])
  @@index([providerOrderId])
  @@index([status])
  @@index([country])
  @@index([service])
  @@index([activationType])
}

model SmsMessage {
  id         String   @id @default(uuid())
  orderId    String
  code       String?
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  fullText   String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PricingRule {
  id             String   @id @default(uuid())
  country        String
  service        String
  markupPercent  Float
  createdAt      DateTime @default(now())
  fixedMarkupNgn Decimal  @default(0) @db.Decimal(18, 2)

  @@index([country])
  @@index([service])
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  reference        String        @unique
  amount           Decimal       @db.Decimal(18, 2)
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  gatewayReference String?
  providerResponse Json?
  updatedAt        DateTime      @updatedAt
  currency         String        @default("NGN")
  paidAt           DateTime?
  provider         String        @default("PAYSTACK")
  verifiedAt       DateTime?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reference])
  @@index([status])
  @@index([userId])
}

model ApiKey {
  id        String   @id @default(uuid())
  userId    String
  key       String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id          String               @id @default(uuid())
  title       String
  message     String
  active      Boolean              @default(true)
  type        NotificationType     @default(GENERAL)
  style       NotificationStyle    @default(ICON_BADGE)
  telegramUrl String?
  whatsappUrl String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([active])
  @@index([createdAt])
  @@index([type])
}

enum NotificationType {
  GENERAL
  WELCOME_NEW
  WELCOME_BACK
}

enum NotificationStyle {
  MINIMAL
  BANNER
  ICON_BADGE
  SPLIT
}

enum UserRole {
  USER
  ADMIN
}

enum TransactionType {
  CREDIT
  DEBIT
  DEPOSIT
  PURCHASE
  REFUND
  TRANSFER
}

enum OrderStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
  BANNED
  TIMEOUT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED 
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  X
  SNAPCHAT
  TELEGRAM
  DISCORD
  REDDIT
  LINKEDIN
  YOUTUBE
  GMAIL
  OUTLOOK
  VPN
  TEXTPLUS
  NEXTPLUS
  MAIL
}

enum SocialLogCategory {
  FACEBOOK_PAGE
  FACEBOOK_COUNTRY
  TWITTER_FOLLOWERS
  INSTAGRAM_FOLLOWERS
  VPN
  TEXTPLUS_NEXTPLUS
  TELEGRAM_ACCOUNT
  TIKTOK_COUNTRY
  TIKTOK_FOLLOWERS
  TUTORIAL
  WEBSITE_CREATION
  MAIL
}

enum SocialLogPageType {
  CREATE_PAGE
  CREATED_PAGE
  MULTI_PAGE
  PAGE_WITH_FOLLOWERS
}

enum InstagramSubType {
  MONTHS_OLD
  EMPTY_AGED
  AGED_500
  AGED_1K
}

enum VpnType {
  PIA_7D
  EXPRESS_1M
  HMA_1M
  NORD_1M
}

enum TutorialType {
  FACEBOOK_ADS
  INSTAGRAM_ADS
  TIKTOK_ADS
  TWITTER_ADS
}

enum WebsiteType {
  LOGS_WEBSITE
  SMS_WEBSITE
  BOTH_WEBSITE
  BOOSTING_WEBSITE
}

enum SocialLogStatus {
  AVAILABLE
  SOLD
}
